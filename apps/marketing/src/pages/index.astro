---
import Base from "~/layouts/Base.astro";
import { site } from "~/site.config";
---
<Base>
  <section class="px-6 py-20 max-w-6xl mx-auto">
    <p class="text-accent uppercase tracking-wide text-sm font-medium">For creators</p>
    <h1 class="text-5xl font-semibold mt-3 max-w-3xl leading-tight">
      {site.tagline}
    </h1>
    <p class="mt-6 text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl">
      {site.name} analyses any public creator channel and recommends partners who will actually move the needle —
      across YouTube, Instagram, and TikTok.
    </p>
    <div class="mt-8 flex gap-3">
      <a href={site.appUrl} class="rounded-md bg-accent text-white px-6 py-3 font-medium hover:bg-accent-hover">
        Open the app
      </a>
      <a href="#how" class="rounded-md border px-6 py-3 font-medium hover:border-accent">
        How it works
      </a>
    </div>
  </section>

  <section id="how" class="px-6 py-16 max-w-6xl mx-auto grid md:grid-cols-3 gap-6">
    <div>
      <h3 class="font-semibold text-lg">1. Connect a channel</h3>
      <p class="mt-2 text-neutral-600 dark:text-neutral-300">Paste any YouTube, Instagram, or TikTok URL or handle. We never need your password.</p>
    </div>
    <div>
      <h3 class="font-semibold text-lg">2. AI analyses content</h3>
      <p class="mt-2 text-neutral-600 dark:text-neutral-300">We profile niche, audience persona, content pillars, and brand-safety signals from public data.</p>
    </div>
    <div>
      <h3 class="font-semibold text-lg">3. Get matched collaborators</h3>
      <p class="mt-2 text-neutral-600 dark:text-neutral-300">An explainable fit score plus AI rationale — save your favourites and draft outreach in one click.</p>
    </div>
  </section>

  <section id="scoring" class="px-6 py-16 max-w-6xl mx-auto">
    <h2 class="text-3xl font-semibold">An explainable fit score</h2>
    <p class="mt-3 text-neutral-600 dark:text-neutral-300 max-w-2xl">Every recommendation comes with a transparent breakdown across niche, audience, engagement, region, format, content style, and platform compatibility — so you trust the picks.</p>
  </section>
</Base>
