{
  "name": "tandem",
  "private": true,
  "version": "0.1.0",
  "description": "Tandem (working name) - multi-platform creator collaboration tool. Monorepo root.",
  "workspaces": [
    "apps/marketing",
    "functions",
    "packages/branding",
    "packages/shared-types",
    "tools"
  ],
  "scripts": {
    "postinstall": "npm run branding",
    "branding": "tsx tools/apply-branding.ts",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "emulators": "firebase emulators:start",
    "deploy:marketing": "firebase deploy --only hosting:marketing",
    "deploy:app": "firebase deploy --only hosting:app",
    "deploy:backend": "firebase deploy --only functions,firestore,storage"
  },
  "devDependencies": {
    "firebase-tools": "^13.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
